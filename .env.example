# ---------------------------------------------------------------------------
# DELF B2 Production Orale (Gemini) — environment
# Copy to .env.local and fill in. NEVER commit .env.local.
# ---------------------------------------------------------------------------

# Gemini (server-side only — the browser never sees this key; it receives a
# short-lived ephemeral token minted by /api/live-token instead).
GEMINI_API_KEY=

# Clerk (https://dashboard.clerk.com → your app → API keys)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Where Clerk sends users. Keep in sync with the route folders.
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# Where Clerk sends them afterwards, when nothing else asked for a destination.
# "Fallback", not "force": a candidate bounced to sign-in from an exam in
# progress carries a redirect_url, and that must win over the dashboard.
# (These are the Clerk v5+ names. NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL and its
# sign-up twin are the deprecated ones — do not reintroduce them.)
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/app
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/app

# Neon Postgres (https://console.neon.tech → connection string, pooled)
DATABASE_URL=

# Optional: force a reconnect N seconds into the debate to exercise session
# resumption without waiting for Gemini's real ~10 min connection limit.
# Unset/0 disables it. See docs/SESSION_RESUMPTION.md.
NEXT_PUBLIC_DEBATE_FORCE_RECONNECT_SECONDS=

# Development tooling on a DEPLOYED environment (#36).
#
# Switches on the exposé's « Dev · transcription directe » panel and the
# duration a typed sitting may claim. Both are ways to produce a graded exam
# without speaking, so this is off unless set, and it is ignored outright on a
# production deployment.
#
# Local `pnpm dev` does NOT need this — it is already on there.
# On Vercel, set it on the Preview/staging environment only, never at the
# project level: a project-wide value is what would put it in front of
# candidates.
NEXT_PUBLIC_DEV_TOOLS=
