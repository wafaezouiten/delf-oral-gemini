# Prettier 3 already respects .gitignore, so build output and node_modules need
# no entries here. This file lists only committed content Prettier must not own.

# Generated by drizzle-kit — migrations and meta snapshots are regenerated
# byte-for-byte; reformatting them would diff against the generator.
drizzle/

# pnpm's file, in pnpm's format.
pnpm-lock.yaml

# Captured comparison runs are recorded artefacts, not source — a historical
# capture should stay byte-identical to what the run produced.
docs/comparison/runs/*.json

# Served verbatim, including the reference replica used for visual checks (#87).
public/

# Rewritten by `next dev` (see the note at the top of the file itself);
# formatting it would fight the generator.
AGENTS.md

# Sibling checkouts, when two sessions work this repository at once. Untracked
# and not in .gitignore, so the rule above about Prettier reading .gitignore
# does not cover them — and a worktree that has been built carries its own
# `.next/types/*`, which is generated code this repository never formats.
.claude/worktrees/
