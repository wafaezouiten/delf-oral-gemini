{
  "name": "delf-oral-gemini",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "pnpm typecheck && eslint && pnpm format:check",
    "test:unit": "node --import tsx --experimental-test-module-mocks --disable-warning=ExperimentalWarning --test \"src/**/*.test.ts\"",
    "test:e2e": "playwright test",
    "test:e2e:auth": "tsx e2e/capture-session.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "announcements": "tsx scripts/generate-announcements.ts",
    "exp:audio": "tsx experiments/audio-vs-text.ts",
    "smoke": "tsx scripts/smoke-gemini.ts",
    "verify:live": "tsx scripts/verify-live.ts",
    "verify:eval": "cross-env NODE_OPTIONS=--conditions=react-server tsx scripts/verify-eval.ts",
    "verify:db": "cross-env NODE_OPTIONS=--conditions=react-server tsx scripts/verify-persistence.ts",
    "verify:constraints": "cross-env NODE_OPTIONS=--conditions=react-server tsx scripts/verify-constraints.ts",
    "verify:vault": "cross-env NODE_OPTIONS=--conditions=react-server tsx scripts/verify-vault.ts",
    "verify:transcript": "cross-env NODE_OPTIONS=--conditions=react-server tsx scripts/verify-monologue-transcript.ts",
    "compare": "cross-env NODE_OPTIONS=--conditions=react-server tsx scripts/compare.ts",
    "compare:summarise": "tsx scripts/comparison/summarise.ts",
    "measure:live": "cross-env NODE_OPTIONS=--conditions=react-server tsx scripts/measure-live.ts",
    "models": "node scripts/list-models.mjs"
  },
  "dependencies": {
    "@clerk/localizations": "^4.14.2",
    "@clerk/nextjs": "^7.7.1",
    "@google/genai": "^2.16.0",
    "@neondatabase/serverless": "^1.1.0",
    "@vercel/blob": "^2.8.0",
    "drizzle-orm": "^0.45.2",
    "next": "16.3.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "cross-env": "^10.1.0",
    "dotenv": "^17.4.2",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "eslint-config-next": "16.3.0",
    "prettier": "3.9.6",
    "prettier-plugin-tailwindcss": "0.8.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.12",
    "typescript": "^5"
  },
  "packageManager": "pnpm@11.11.0"
}
