        "evaluations_bands_check": {
          "name": "evaluations_bands_check",
          "value": "\"evaluations\".\"realisation_tache\" in (0, 1, 3, 5)\n        and \"evaluations\".\"interaction\" in (0, 1, 3, 5)\n        and \"evaluations\".\"lexique\" in (0, 1, 3, 5)\n        and \"evaluations\".\"morphosyntaxe\" in (0, 1, 3, 5)\n        and \"evaluations\".\"phonologie\" in (0, 1, 3, 5)"
        },
        "evaluations_score_range_check": {
          "name": "evaluations_score_range_check",
          "value": "\"evaluations\".\"raw_score_25\" between 0 and 25 and \"evaluations\".\"score_25\" between 0 and 25\n        and \"evaluations\".\"duration_penalty\" >= 0 and \"evaluations\".\"absence_penalty\" >= 0"
        },
        "evaluations_score_25_check": {
          "name": "evaluations_score_25_check",
          "value": "\"evaluations\".\"score_25\" = greatest(\"evaluations\".\"raw_score_25\" - \"evaluations\".\"absence_penalty\" - \"evaluations\".\"duration_penalty\", 0)"
        }
      },
